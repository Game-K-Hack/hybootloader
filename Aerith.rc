// Aerith.rc - ressource de version de HyBootloader.
// FILEVERSION au-dessus de celle du JKD (9.0.0.1) qu'il remplace : un outil qui
// compare les versions avant de recopier Aerith.exe prend donc le notre.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    9,9,9,9
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Harlock"
            VALUE "FileDescription",  "HyBootloader"
            VALUE "FileVersion",      "9.9.9.9"
            VALUE "InternalName",     "HyBootloader"
            VALUE "OriginalFilename", "Aerith.exe"
            VALUE "ProductName",      "HyBootloader"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "LegalCopyright",   "by Harlock"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
